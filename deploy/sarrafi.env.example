# TEMPLATE ONLY: copy outside releases to /etc/sarrafi/sarrafi.env (0640).
# Set the two empty secrets privately. Do not commit the real environment.
SECRET_KEY=
DEBUG=false
SARRAFI_DESKTOP=false
ALLOWED_HOSTS=accounts.example.invalid
CSRF_TRUSTED_ORIGINS=https://accounts.example.invalid
SECURE_SSL_REDIRECT=true
SARRAFI_DATA_DIR=/var/lib/sarrafi
SARRAFI_MEDIA_ROOT=/var/lib/sarrafi/media
DB_ENGINE=postgresql
DB_NAME=sarrafi
DB_USER=sarrafi
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
TIME_ZONE=Asia/Tehran
DISPLAY_UNIT=rial
BASE_CURRENCY_CODE=IRR
