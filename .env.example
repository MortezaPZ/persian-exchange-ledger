# ---------------------------------------------------------------
# نمونه فایل تنظیمات محیط. یک کپی از این فایل با نام .env بسازید.
# ---------------------------------------------------------------

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- پایگاه‌داده ---------------------------------------------------
# اگر DB_ENGINE=postgres باشد از PostgreSQL استفاده می‌شود؛
# در غیر این صورت SQLite (فقط برای توسعه/دمو).
DB_ENGINE=sqlite

DB_NAME=sarrafi
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- واحد نمایش مبالغ پایه ---------------------------------------
# rial  : مبالغ همان‌طور که ذخیره شده (ریال) نمایش داده می‌شود
# toman : مبالغ هنگام نمایش تقسیم بر ۱۰ و هنگام ورود ضرب در ۱۰ می‌شود
DISPLAY_UNIT=rial

# --- زمان ---------------------------------------------------------
TIME_ZONE=Asia/Tehran
